# ============================================================================
#  GLEXCO — Variables de entorno (copiar a .env y ajustar)
#  cp .env.example .env
#
#  REGLA: ningun secreto real entra a este archivo ni al repositorio.
#  En Railway/AWS se inyectan por el gestor de variables del proveedor.
# ============================================================================

NODE_ENV=development
LOG_LEVEL=debug
# Nombre publico de la plataforma en correos y certificados
PLATFORM_NAME=GLEXCO
PLATFORM_URL=http://localhost:3010

# ---------------------------------------------------------------------------
# Base de datos — un cluster, un schema y un rol por servicio.
# En produccion cada servicio recibe SOLO su propia URL.
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=glexco

DATABASE_URL_IDENTITY=postgresql://glexco_identity:glexco_local_dev@localhost:5432/glexco?schema=identity
DATABASE_URL_INSTITUTIONS=postgresql://glexco_institutions:glexco_local_dev@localhost:5432/glexco?schema=institutions
DATABASE_URL_CATALOG=postgresql://glexco_catalog:glexco_local_dev@localhost:5432/glexco?schema=catalog
DATABASE_URL_LEARNING=postgresql://glexco_learning:glexco_local_dev@localhost:5432/glexco?schema=learning
DATABASE_URL_ASSESSMENT=postgresql://glexco_assessment:glexco_local_dev@localhost:5432/glexco?schema=assessment
DATABASE_URL_ENGAGEMENT=postgresql://glexco_engagement:glexco_local_dev@localhost:5432/glexco?schema=engagement
DATABASE_URL_ANALYTICS=postgresql://glexco_analytics:glexco_local_dev@localhost:5432/glexco?schema=analytics
DATABASE_URL_MEDIA=postgresql://glexco_media:glexco_local_dev@localhost:5432/glexco?schema=media

# Pool por instancia. Con N replicas el total es DB_POOL_MAX * N: mantenerlo bajo
# para no agotar max_connections del Postgres gestionado.
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Redis — cache, rate limiting, sesiones/refresh tokens, locks y colas BullMQ.
# ---------------------------------------------------------------------------
REDIS_URL=redis://:glexco_local_dev@localhost:6379
REDIS_KEY_PREFIX=glexco
CACHE_DEFAULT_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Bus de eventos — NATS JetStream (comunicacion asincrona entre servicios).
# ---------------------------------------------------------------------------
NATS_URL=nats://localhost:4222
NATS_STREAM=GLEXCO

# ---------------------------------------------------------------------------
# Autenticacion
# Generar cada secreto con: openssl rand -base64 48
# El access token es corto y sin estado; el refresh es largo, rotativo y su
# familia vive en Redis para poder revocarla ante robo de token.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=cambiar-en-produccion-openssl-rand-base64-48
JWT_REFRESH_SECRET=cambiar-en-produccion-otro-secreto-distinto
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=glexco.platform
JWT_AUDIENCE=glexco.web

# Firma de URLs internas y de verificacion de certificados
SIGNING_SECRET=cambiar-en-produccion-openssl-rand-base64-48

# Pimienta con la que se hashean los codigos de activacion de los libros.
# No tiene valor por defecto en el codigo a proposito: si lo tuviera, un
# despliegue descuidado usaria el de ejemplo y los hashes serian reproducibles
# por cualquiera que conozca el repositorio.
# CAMBIARLA INVALIDA TODOS LOS CODIGOS YA EMITIDOS: se fija una vez y no se rota.
ACTIVATION_CODE_PEPPER=cambiar-en-produccion-openssl-rand-base64-48

# Token compartido para las llamadas entre microservicios (API /internal).
INTERNAL_SERVICE_TOKEN=cambiar-en-produccion-openssl-rand-base64-48

# Hash de contrasenas: argon2id (recomendado) | bcrypt (compatibilidad)
PASSWORD_HASHER=argon2id
BCRYPT_ROUNDS=12
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Cookies (el refresh token nunca queda accesible a JavaScript)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# Almacenamiento de objetos — MinIO en local, S3 / Huawei OBS en produccion.
# Todos los buckets son privados: se accede con URLs prefirmadas de corta vida.
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=glexco
S3_SECRET_KEY=glexco_local_dev
S3_FORCE_PATH_STYLE=true
S3_BUCKET_MEDIA=glexco-media
S3_BUCKET_DOCUMENTS=glexco-documents
S3_BUCKET_EVIDENCE=glexco-evidence
S3_BUCKET_CERTIFICATES=glexco-certificates
S3_PRESIGN_TTL_SECONDS=900

# Proveedor de video externo. Vacio en local: el video se sirve del bucket
# propio con URL prefirmada, que vale para desarrollar y nada mas. En
# produccion el arranque ABORTA si faltan, porque servir video desde nuestro
# ancho de banda es lo primero que dispara la factura, y ademas el proveedor es
# quien aplica la restriccion de dominio que impide compartir el enlace.
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_API_KEY=

# Proveedor de video para contenido pesado (estrategia hibrida)
VIDEO_PROVIDER=local
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_LIBRARY_ID=

# ---------------------------------------------------------------------------
# Correo — Mailpit en local (http://localhost:8025)
# ---------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="GLEXCO <no-reply@glexco.pe>"

# ---------------------------------------------------------------------------
# Observabilidad
# ---------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=glexco

# ---------------------------------------------------------------------------
# Red / puertos (el gateway es el unico expuesto al exterior)
# ---------------------------------------------------------------------------
GATEWAY_PORT=3000
IDENTITY_PORT=3101
INSTITUTIONS_PORT=3102
CATALOG_PORT=3103
LEARNING_PORT=3104
ASSESSMENT_PORT=3105
ENGAGEMENT_PORT=3106
ANALYTICS_PORT=3107
MEDIA_PORT=3108

IDENTITY_URL=http://localhost:3101
INSTITUTIONS_URL=http://localhost:3102
CATALOG_URL=http://localhost:3103
LEARNING_URL=http://localhost:3104
ASSESSMENT_URL=http://localhost:3105
ENGAGEMENT_URL=http://localhost:3106

# Base de los enlaces que van dentro de los correos. Apunta al PORTAL y no a la
# API: quien abre el mensaje es una persona y tiene que aterrizar en una
# pantalla, no en un JSON.
WEB_URL=http://localhost:3010
ANALYTICS_URL=http://localhost:3107
MEDIA_URL=http://localhost:3108

CORS_ORIGINS=http://localhost:3010
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
# Limite de las rutas de autenticacion. En PRODUCCION mantenlo bajo (10 por
# minuto y por IP): ahi el ataque no es saturar sino adivinar credenciales. En
# local se sube porque la prueba de humo hace once llamadas de autenticacion
# seguidas desde la misma IP y con 10 nunca podria terminar.
RATE_LIMIT_AUTH_MAX=60

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_SUPPORTED_LOCALES=es,en
